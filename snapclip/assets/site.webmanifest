{
 "name": "SnapClip: Video Downloader",
 "short_name": "SnapClip",
 "start_url": "/snapclip/",
 "scope": "/snapclip/",
 "display": "browser",
 "background_color": "#F6F4FB",
 "theme_color": "#6A4BEF",
 "icons": [
  {
   "src": "/snapclip/assets/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "/snapclip/assets/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "/snapclip/assets/icon.svg",
   "sizes": "any",
   "type": "image/svg+xml"
  }
 ]
}
